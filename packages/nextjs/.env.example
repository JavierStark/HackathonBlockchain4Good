# Template for Next.js environment variables.
#
# For local development: copy this file, rename it to .env.local, fill in what you
# need. In Vercel, set the same names under Project Settings → Environment Variables
# (scoped per Preview/Production environment).
#
# Everything prefixed NEXT_PUBLIC_ is bundled into client-side JS and visible to
# anyone who opens the app — treat it as PUBLIC, never put a secret behind that
# prefix. Next.js reads .env.local automatically; access values via
# process.env.VARIABLE_NAME. https://nextjs.org/docs/app/guides/environment-variables

# ============================================================================
# PUBLIC — safe defaults are provided; override only if you hit rate limits or
# need your own project
# ============================================================================

# Only consulted for chains that don't already have a free public RPC configured
# in scaffold.config.ts's targetNetworks (foundry/sepolia/baseSepolia don't need
# it). Get your own at https://dashboard.alchemyapi.io if you add an Alchemy-only
# network.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# RainbowKit wallet connection. A shared demo project ID is used if this is
# empty — fine for local dev, but get your own free ID for anything you demo
# publicly: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# Set to "true" only when building for the static IPFS/GitHub Pages export
# (`yarn ipfs`). Leave unset for the normal Vercel/dev build.
NEXT_PUBLIC_IPFS_BUILD=

# Set to "true" to let `next build` succeed despite TypeScript/ESLint errors.
# Emergency-only for a demo deadline — never leave this on by default, it hides
# real bugs.
NEXT_PUBLIC_IGNORE_BUILD_ERROR=

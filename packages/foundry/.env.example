# Template for Foundry environment variables.
#
# For local development: copy this file, rename it to .env, fill in what you need.
# (This already happened automatically on `yarn install` via the postinstall hook —
# edit packages/foundry/.env directly, it is gitignored.)
#
# Everything here is either a SECRET (never commit, never print, never share) or a
# PUBLIC config value. Required-ness depends on which network you're targeting —
# see the matrix in docs/development.md.

# ============================================================================
# SECRETS — do not commit, do not paste into chat/PRs/CI logs
# ============================================================================

# DEPLOYER_PRIVATE_KEY is written here automatically by `yarn generate` /
# `yarn account:import`. Leave it empty for local Anvil deploys — the Makefile
# imports Anvil's well-known throwaway test key (0x2a87...d409c6) into a local
# keystore for you. NEVER put a real/mainnet private key here or in any keystore
# used for local development.
DEPLOYER_PRIVATE_KEY=

# API key for an Etherscan-family explorer (Ethereum mainnet/Sepolia, Optimism,
# Arbitrum). Etherscan's v2 API is multichain on one key.
# Get one at https://etherscan.io/apis (free tier is enough for a hackathon).
ETHERSCAN_API_KEY=

# Basescan — required only to verify contracts on Base / Base Sepolia (our
# default L2 target). Get one at https://basescan.org/apis
BASESCAN_API_KEY=

# Polygonscan — required only if you deploy to Polygon / Polygon Amoy.
POLYGONSCAN_API_KEY=

# ============================================================================
# PUBLIC — safe defaults are provided; override only if you hit rate limits or
# need your own infra
# ============================================================================

# Only used for the `mainnet`/`arbitrum`/`optimism`/`polygon` RPC entries in
# foundry.toml (Alchemy-hosted). Every network we actually deploy to during the
# hackathon (localhost, sepolia, baseSepolia) uses a free public RPC instead —
# you do not need this key to build the MVP.
ALCHEMY_API_KEY=

# Required only for `yarn deploy --network production` — see foundry.toml's
# [rpc_endpoints] "production" entry. Left empty, that deploy fails fast instead
# of silently hitting a placeholder endpoint. Set this once the team has picked
# the real launch chain, never before.
PRODUCTION_RPC_URL=

# Which local keystore account to use for `localhost`/Anvil deploys.
# "scaffold-eth-default" = Anvil's prefunded account #9, zero setup, zero risk.
# Switch to "scaffold-eth-custom" only if you generated/imported your own local
# keystore via `yarn generate` / `yarn account:import`.
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-eth-default
